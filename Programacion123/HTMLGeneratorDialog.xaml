                        <Label Content="S" Height="28" Canvas.Left="345" Canvas.Top="124" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <CheckBox x:Name="CheckboxTextElementUnderscore" Content="" Canvas.Left="362" Canvas.Top="132" Effect="{DynamicResource EffectDropShadow}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Label Content="Espaciado&#xD;&#xA;alrededor" Height="76" Canvas.Left="22" Canvas.Top="226" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <ComboBox x:Name="ComboTextElementMarginBottom" Width="68" Canvas.Left="144" Canvas.Top="233" Effect="{DynamicResource EffectDropShadow}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ComboTextElementMarginTop" Width="68" Canvas.Left="246" Canvas.Top="233" Effect="{DynamicResource EffectDropShadow}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Label Content="Elemento" Height="28" Canvas.Left="22" Canvas.Top="32" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <Image Height="20" Width="20" Canvas.Left="119" Canvas.Top="233" HorizontalAlignment="Left" VerticalAlignment="Center" Source="/Images/CaptionSeparationBottom.png"/>
