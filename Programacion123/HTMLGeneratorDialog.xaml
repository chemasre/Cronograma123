                        <Image Height="20" Width="20" Canvas.Left="221" Canvas.Top="276" Source="/Images/CaptionSeparationLeft.png" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Canvas>
                </TabItem>
                <TabItem Header="Tablas">
