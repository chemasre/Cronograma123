        xmlns:local="clr-namespace:Programacion123"
        mc:Ignorable="d"
        Title="HTMLGeneratorSettings" Height="900" Width="1500" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True" WindowStyle="None" Background="{x:Null}" MouseDown="Window_MouseDown" ShowInTaskbar="False" FontSize="{DynamicResource NormalTextSize}" MinWidth="1500" MinHeight="900" FontFamily="{DynamicResource Font}">
