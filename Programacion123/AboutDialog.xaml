        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Programacion123"
        mc:Ignorable="d"
        Title="About" Height="524" Width="604" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Foreground="{x:Null}" Background="{x:Null}" WindowStyle="None" AllowsTransparency="True" MouseDown="Window_MouseDown" HorizontalAlignment="Right" FontFamily="{DynamicResource Font}" ResizeMode="NoResize" MinWidth="604" MinHeight="524">
    <Border x:Name="BorderWindow" Padding="5" BorderThickness="3,3,3,3" CornerRadius="30" BorderBrush="{DynamicResource WindowBorder}" >
        <Border.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="/Images/BackgroundClouds.jpg"/>
        </Border.Background>
