            </Border>
            <Button Effect="{DynamicResource EffectDropShadow}" x:Name="ButtonClose" Content="" Height="40" Width="40" Click="ButtonClose_Click" Canvas.Left="537" BorderBrush="{x:Null}" Canvas.Top="10" Style="{DynamicResource PushableButton}" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/ButtonClose.png"/>
                </Button.Background>
            </Button>
            <Border BorderThickness="1" Height="63" Width="195" Canvas.Left="362" Canvas.Top="429" CornerRadius="30,30,30,30" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border.Background>
                    <ImageBrush ImageSource="/Images/BackgroundSteps.jpg" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
            <Label Content="Aceptar" FontSize="24" FontFamily="{DynamicResource TitleFont}" Width="106" Canvas.Left="392" Canvas.Top="440" Foreground="{DynamicResource FreeLabelMainWindow}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Button Effect="{DynamicResource EffectDropShadow}" x:Name="ButtonAccept" Content="" Height="48" Width="48" Canvas.Left="498" BorderBrush="{x:Null}" Canvas.Top="435" Style="{DynamicResource PushableButton}" Click="ButtonAccept_Click" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/ButtonAccept.png"/>
                </Button.Background>
            </Button>
            <Border BorderThickness="1" Height="8" Width="293" Canvas.Left="30" Canvas.Top="458" CornerRadius="30,30,30,30" Background="#99EDEBB1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Label x:Name="LabelVersion" Content="v0.0.0" FontSize="{DynamicResource NormalTextSize}" Width="102" Canvas.Left="438" Canvas.Top="377" FontFamily="{DynamicResource Font}" HorizontalAlignment="Center" VerticalAlignment="Top" FontWeight="Bold" Foreground="#33000000" HorizontalContentAlignment="Right"/>
            <TabControl Height="306" Width="511" Canvas.Top="90" Canvas.Left="39" BorderBrush="#00ACACAC" Opacity="0.985" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" Background="{x:Null}">
                <TabItem Header="Presentación">
                    <Canvas HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock TextWrapping="Wrap" Height="94" Foreground="Black" FontSize="16" Canvas.Left="130" Canvas.Top="24" VerticalAlignment="Top" Width="372" HorizontalAlignment="Center"><Run FontWeight="Bold" Text="Programabara"/><Run Text=" es "/><Run Text="un"/><Run Text=" "/><Run Text="generador de "/><Run FontWeight="Bold" Text="programaciones didácticas"/><Run Text=" en formato "/><Run FontWeight="Bold" Text="Word(*)"/><Run Text=" o "/><Run FontWeight="Bold" Text="HTML"/><Run Text=" "/><Run Text="para Ciclos Formativos de Grado "/><Run Text="Medio y "/><Run Text="Superior"/><Run Text=" a"/><Run Text="daptado a la legislación vigente en España"/><Run Text="."/><Run Text=" Es "/><Run FontWeight="Bold" Text="gratuito"/><Run Text=" para uso "/><Run FontWeight="Bold" Text="no comercial"/><Run Text="."/></TextBlock>
                        <TextBlock TextWrapping="Wrap" Height="133" Foreground="Black" FontSize="16" Canvas.Left="7" Canvas.Top="136" Width="495" HorizontalAlignment="Center" VerticalAlignment="Top"><Run Text="Si "/><Run Text="quieres agradecerme el esfuerzo"/><Run Text=", "/><Run Text="puedes escribir "/><Run Text="un correo a "/><Run FontWeight="Bold" Text="chema.sre@gmail.com"/><Run Text=" "/><Run Text="contándome"/><Run Text=" qué "/><Run Text="enseñas"/><Run Text=", qué cosas podrían mejorarse o lo que te apetezca compartir."/><Run Text=" Mi nombre es José Manuel (Chema) Solís."/><LineBreak/><Run/><LineBreak/><Run Text="(*)"/><Run Text=" "/><Run FontStyle="Italic" Text="N"/><Run FontStyle="Italic" Text="ecesita"/><Run FontStyle="Italic" Text="rás tener "/><Run FontStyle="Italic" Text="instalada una versión reciente de "/><Run FontStyle="Italic" Text="Microsoft Word en el equipo"/><Run Text="."/></TextBlock>
                        <Image x:Name="IconApp" Height="100" Canvas.Left="13" Canvas.Top="24" Width="100" Source="/Images/IconProgramabara.png" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand" MouseDown="IconApp_MouseDown" Effect="{DynamicResource EffectDropShadow}">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Canvas>
                </TabItem>
                <TabItem Header="Créditos" Margin="-2,-2,-2,0">
                    <Canvas HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock TextWrapping="Wrap" Height="105" Foreground="Black" FontSize="16" Canvas.Left="194" Canvas.Top="24" Width="308" HorizontalAlignment="Center" VerticalAlignment="Top"><Run Text="Esta aplicación se distribuye "/><Run Text="bajo"/><Run Text=" una licencia "/><Run FontWeight="Bold" Text="Creative Commons"/><Run Text=" que "/><Run Text="permite "/><Run Text="su uso "/><Run FontWeight="Bold" Text="no comercial"/><Run Text=", así como su copia y distribución siempre y cuando "/><Run FontWeight="Bold" Text="se acredite al autor y no se realicen modificaciones"/><Run Text="."/></TextBlock>
                        <TextBlock TextWrapping="Wrap" Height="133" Foreground="Black" FontSize="16" Canvas.Left="2" Canvas.Top="134" Width="500" HorizontalAlignment="Center" VerticalAlignment="Top"><Run Text="Licencias de "/><Run Text="recursos de terceros:"/><LineBreak/><Run Text="--------------------------------------------------------------------------------------------------------"/><LineBreak/><Run Text="Fotografía "/><Run FontWeight="Bold" Text="&quot;Capybara&quot;"/><Run Text=" por "/><Run FontWeight="Bold" Text="lorentey"/><Run Text=" usada bajo licencia "/><Run FontWeight="Bold" Text="CC BY 2.0"/><Run Text="."/><LineBreak/><Run Text="--------------------------------------------------------------------------------------------------------"/><LineBreak/><Run Text="Fotografía "/><Run FontWeight="Bold" Text="&quot;Texture Maple Wood plank stock photo wall Floor&quot;"/><Run Text=" por "/><Run FontWeight="Bold" Text="TextureX.com"/><Run Text=" "/><Run Text="usada bajo licencia "/><Run FontWeight="Bold" Text="CC BY 2.0"/><Run Text="."/></TextBlock>
                        <Image x:Name="IconLicense" Height="52" Canvas.Left="20" Canvas.Top="38" Width="150" Source="/Images/ImageLicense.png" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="Hand" Effect="{DynamicResource EffectDropShadow}" MouseDown="IconLicense_MouseDown">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Canvas>
                </TabItem>
                <TabItem Header="Mis otras aplicaciones" Margin="-2,-2,-2,0">
                    <Canvas HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock TextWrapping="Wrap" Height="113" Foreground="Black" FontSize="16" Canvas.Left="143" Canvas.Top="153" Width="359" HorizontalAlignment="Center" VerticalAlignment="Top"><Run FontWeight="Bold" Text="MiniBoy Color"/><LineBreak/><Run/><LineBreak/><Run Text="Aplicación que permite aprender cómo funciona a nivel fundamental un procesador y programar pequeñas aplicaciones y juegos utilizando un lenguaje ensamblador simplificado."/></TextBlock>
                        <TextBlock TextWrapping="Wrap" Height="118" Foreground="Black" FontSize="16" Canvas.Left="143" Canvas.Top="16" Width="359" HorizontalAlignment="Left" VerticalAlignment="Center"><Run FontWeight="Bold" Text="Turtle Sandbox"/><LineBreak/><Run/><LineBreak/><Run Text="Entorno para aprender a programar en C# inspirado en LOGO. Está orientado a alumnos/as del ciclo de Animación 3D, juegos y entornos interactivos"/><Run Text="."/></TextBlock>
                        <Image x:Name="IconOtherApp1" Height="100" Canvas.Left="16" Canvas.Top="35" Width="100" Source="/Images/IconTurtleSandbox.png" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="Hand" MouseDown="IconOtherApp1_MouseDown" Effect="{DynamicResource EffectDropShadow}">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                        <Image x:Name="IconOtherApp2" Height="100" Canvas.Left="16" Canvas.Top="161" Width="100" Source="/Images/IconMiniBoyColor.png" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="Hand" MouseDown="IconOtherApp2_MouseDown" Effect="{DynamicResource EffectDropShadow}">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                        <TextBlock TextWrapping="Wrap" Height="20" Foreground="Red" FontSize="12" Canvas.Left="54" Canvas.Top="8" Width="69" HorizontalAlignment="Center" VerticalAlignment="Top" Text="Haz click"/>
                        <Image Height="16" Width="16" Source="/Images/CaptionRedArrow.png" RenderTransformOrigin="0.5,0.5" Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Top" Canvas.Left="38" Canvas.Top="14">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Canvas>
                </TabItem>
            </TabControl>
            <Border x:Name="Blocker" Padding="5" Background="#7F000000" CornerRadius="30" Canvas.Left="-8" Canvas.Top="-8" Height="524" Width="604" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Hidden" />

        </Canvas>
    </Border>
</Window>
