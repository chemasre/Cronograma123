            <ListBox x:Name="ListBoxWeekSchedules" Height="96" Width="295" d:ItemsSource="{d:SampleData ItemCount=5}" Canvas.Left="742" Canvas.Top="159" Effect="{DynamicResource EffectDropShadow}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Button x:Name="ButtonWeekScheduleReferenceAdd" Content="" Width="24" Height="24" BorderBrush="{x:Null}" Canvas.Left="742" Canvas.Top="129" Effect="{DynamicResource EffectDropShadow}" Style="{DynamicResource PushableButton}" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/ButonReferenceAdd.png"/>
                </Button.Background>
                <Button.Foreground>
                    <ImageBrush ImageSource="/Images/ButtonNew.png"/>
                </Button.Foreground>
