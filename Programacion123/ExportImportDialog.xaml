            </Border>
            <Label Content="Cancelar" FontSize="22" FontFamily="{DynamicResource TitleFont}" FontWeight="Bold" Width="130" Canvas.Left="884" Canvas.Top="662" Foreground="{DynamicResource FreeLabelMainWindow}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
