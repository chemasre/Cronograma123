            <ListBox x:Name="ListBoxSubjects" Height="96" Width="295" d:ItemsSource="{d:SampleData ItemCount=5}" Canvas.Left="742" Canvas.Top="328" Effect="{DynamicResource EffectDropShadow}" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            <Button x:Name="ButtonSubjectReferenceAdd" Content="" Width="24" Height="24" BorderBrush="{x:Null}" Canvas.Left="742" Canvas.Top="298" Effect="{DynamicResource EffectDropShadow}" Style="{DynamicResource PushableButton}" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/ButonReferenceAdd.png"/>
                </Button.Background>
                <Button.Foreground>
                    <ImageBrush ImageSource="/Images/ButtonNew.png"/>
