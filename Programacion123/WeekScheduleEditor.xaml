<Window x:Class="Programacion123.WeekScheduleEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Programacion123"
    mc:Ignorable="d"
    Title="WeekScheduleEditor" Height="466" Width="460" Topmost="True" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" MouseDown="Window_MouseDown" AllowsTransparency="True" Background="{x:Null}" FontFamily="{DynamicResource Font}" ShowInTaskbar="False" FontSize="{DynamicResource NormalTextSize}" MinWidth="460" MinHeight="466">
    <Border x:Name="BorderWindow" Padding="5" BorderThickness="3,3,3,3" CornerRadius="30" BorderBrush="{DynamicResource WindowBorder}" >
        <Border.Background>
            <ImageBrush ImageSource="/Images/BackgroundClouds.png" Stretch="UniformToFill"/>
        </Border.Background>
        <Canvas>
            <Border Background="{DynamicResource TitleBackground}" BorderThickness="1" Height="58" Width="444" CornerRadius="30,30,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            </Border>

            <DataGrid x:Name="WeekDataGrid" d:ItemsSource="{d:SampleData ItemCount=5}" ColumnWidth="*" SelectionMode="Single" SelectionUnit="Cell" SelectedCellsChanged="WeekDataGrid_SelectedCellsChanged" Height="180" Canvas.Left="27" Canvas.Top="142" Width="394" BorderBrush="{x:Null}" Background="{x:Null}" HorizontalGridLinesBrush="#FF9BD6FB" VerticalGridLinesBrush="#FF9BD6FB" Effect="{DynamicResource EffectDropShadow}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Label x:Name="TextEditorTitle" Content="Horario" FontSize="{DynamicResource WindowTitleSize}" Width="366" HorizontalAlignment="Left" Canvas.Left="23" Canvas.Top="7" VerticalAlignment="Center" Foreground="White" FontFamily="{DynamicResource WindowTitleFont}" FontWeight="Bold"/>
            <Button Effect="{DynamicResource EffectDropShadow}" x:Name="ButtonClose" Content="" Height="40" Width="40" Click="ButtonClose_Click" HorizontalAlignment="Left" Canvas.Left="394" VerticalAlignment="Center" BorderBrush="{x:Null}" Canvas.Top="10" Style="{DynamicResource PushableButton}">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/ButtonClose.png"/>
                </Button.Background>
            </Button>
            <Border x:Name="BorderValidation" Padding="5" BorderThickness="0" Background="AntiqueWhite" CornerRadius="10" Canvas.Left="138" Canvas.Top="347" HorizontalAlignment="Left" VerticalAlignment="Center" Width="283" Height="82">
                <TextBlock x:Name="TextValidation" TextWrapping="Wrap" Text="TextBlock" Height="62" Canvas.Left="29" Canvas.Top="303" VerticalAlignment="Center" Margin="5,0,5,0"/>
            </Border>
            <TextBox x:Name="TextTitle" Canvas.Left="102" Canvas.Top="89" Width="319" HorizontalAlignment="Left" VerticalAlignment="Center" Effect="{DynamicResource EffectDropShadow}"/>
            <Label Content="Título" Canvas.Left="27" Canvas.Top="85" HorizontalAlignment="Center" VerticalAlignment="Top" Width="75" Foreground="{DynamicResource FreeLabel}"/>
            <Image Height="100" Canvas.Left="15" Canvas.Top="338" Width="150" Source="/Images/ValidatorCapyBig.png" HorizontalAlignment="Left" VerticalAlignment="Top"/>

        </Canvas>
    </Border>
</Window>