<Window x:Class="Programacion123.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Programacion123"
        mc:Ignorable="d"
        Title="ConfirmDialog" Height="337" Width="624" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{x:Null}" AllowsTransparency="True" MouseDown="Window_MouseDown" ShowInTaskbar="False" MinWidth="624" MinHeight="337" FontFamily="{DynamicResource Font}">
    <Border x:Name="BorderWindow" Padding="5" BorderThickness="3,3,3,3" CornerRadius="30" BorderBrush="{DynamicResource WindowBorder}" >
        <Border.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="/Images/BackgroundClouds.jpg"/>
        </Border.Background>
        <Canvas Margin="0,0,0,2">
            <Border BorderThickness="1" Height="69" Width="608" CornerRadius="30,30,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource TitleBackground}"/>
            <Border x:Name="BorderDescriptionBase" BorderThickness="1" Height="148" Width="588" Canvas.Left="10" Canvas.Top="84" CornerRadius="10,10,10,10" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border.Background>
                    <ImageBrush Stretch="UniformToFill" ImageSource="/Images/BackgroundSteps.jpg"/>
                </Border.Background>
            </Border>
            <Border x:Name="BorderToAlignVerticallyTitle" BorderThickness="1" Height="49" Width="415" HorizontalAlignment="Center" VerticalAlignment="Top" Canvas.Top="10" Canvas.Left="20">
                <TextBlock x:Name="TextTitle" TextWrapping="Wrap" Text="Entidad" FontFamily="{DynamicResource WindowTitleFont}" FontSize="24" FontWeight="Bold" LineStackingStrategy="BlockLineHeight" LineHeight="24" Width="414" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Foreground>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="White"/>
                            <GradientStop Color="White" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
            </Border>
            <Border x:Name="BorderOption1" BorderThickness="1" Height="63" Width="195" Canvas.Left="186" Canvas.Top="246" CornerRadius="30,30,30,30" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border.Background>
                    <ImageBrush ImageSource="/Images/BackgroundSteps.jpg" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
            <Border BorderThickness="1" Height="63" Width="195" Canvas.Left="398" Canvas.Top="246" CornerRadius="30,30,30,30" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border.Background>
                    <ImageBrush ImageSource="/Images/BackgroundSteps.jpg" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
            <Label x:Name="LabelAcceptSingle" Content="Aceptar" FontSize="24" Width="108" Canvas.Left="428" Canvas.Top="257" Foreground="{DynamicResource FreeLabelMainWindow}" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource TitleFont}"/>
            <Label x:Name="LabelAccept" Content="Aceptar" FontSize="22" Width="106" Canvas.Left="216" Canvas.Top="257" Foreground="{DynamicResource FreeLabelMainWindow}" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource TitleFont}"/>
            <Button Effect="{DynamicResource EffectDropShadow}" x:Name="ButtonAccept" Content="" Height="48" Width="48" Canvas.Left="322" BorderBrush="{x:Null}" Canvas.Top="252" Style="{DynamicResource PushableButton}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="ButtonAccept_Click">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/ButtonAccept.png"/>
                </Button.Background>
            </Button>
            <Button Effect="{DynamicResource EffectDropShadow}" x:Name="ButtonCancel" Content="" Height="48" Width="48" Canvas.Left="536" BorderBrush="{x:Null}" Canvas.Top="254" Style="{DynamicResource PushableButton}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="ButtonCancel_Click">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/ButtonClose.png"/>
                </Button.Background>
            </Button>
            <Border x:Name="BorderContent" Padding="5" BorderThickness="0" Background="AntiqueWhite" CornerRadius="10" Canvas.Left="155" Canvas.Top="101" HorizontalAlignment="Left" VerticalAlignment="Center" Width="428" Height="113">
                <TextBlock x:Name="TextContent" TextWrapping="Wrap" Text="TextBlock" Height="92" Canvas.Left="29" Canvas.Top="303" VerticalAlignment="Center" Foreground="Black" Margin="5,0,5,0" FontSize="{DynamicResource NormalTextSize}"/>
            </Border>
            <Image x:Name="IconWarning" Height="100" Canvas.Left="34" Canvas.Top="103" Width="100" Source="/Images/IconWarning.png" HorizontalAlignment="Center" VerticalAlignment="Top" Effect="{DynamicResource EffectDropShadow}"/>
            <Image x:Name="IconInfo" Height="100" Canvas.Left="34" Canvas.Top="103" Width="100" Source="/Images/IconInfo.png" Effect="{DynamicResource EffectDropShadow}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button Effect="{DynamicResource EffectDropShadow}" x:Name="ButtonAcceptSingle" Content="" Height="48" Width="48" Canvas.Left="535" BorderBrush="{x:Null}" Canvas.Top="254" Style="{DynamicResource PushableButton}" Click="ButtonAccept_Click" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/ButtonAccept.png"/>
                </Button.Background>
            </Button>
            <Label x:Name="LabelCancel" Content="Cancelar" FontSize="24" Width="108" Canvas.Left="428" Canvas.Top="257" Foreground="{DynamicResource FreeLabelMainWindow}" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource TitleFont}"/>
            <Image x:Name="IconQuestion" Height="100" Canvas.Left="34" Canvas.Top="103" Width="100" Source="/Images/IconQuestion.png" Effect="{DynamicResource EffectDropShadow}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Label x:Name="LabelYes" Content="Sí" FontSize="24" Width="106" Canvas.Left="216" Canvas.Top="257" Foreground="{DynamicResource FreeLabelMainWindow}" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{DynamicResource TitleFont}"/>
            <Label x:Name="LabelNo" Content="No" FontSize="24" FontFamily="{DynamicResource TitleFont}" Width="108" Canvas.Left="428" Canvas.Top="257" Foreground="{DynamicResource FreeLabelMainWindow}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Border x:Name="Separator1Option" BorderThickness="1" Height="8" Width="360" Canvas.Left="26" Canvas.Top="270" CornerRadius="30,30,30,30" Background="#99EDEBB1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Border x:Name="Separator2Options" BorderThickness="1" Height="8" Width="144" Canvas.Left="26" Canvas.Top="270" CornerRadius="30,30,30,30" Background="#99EDEBB1" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        </Canvas>
    </Border>
</Window>
