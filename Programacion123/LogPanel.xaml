<Window x:Class="Programacion123.LogPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Programacion123"
        mc:Ignorable="d"
        Title="LogPanel" Height="400" Width="900" WindowStyle="None" ResizeMode="NoResize" Topmost="True" Background="{x:Null}" MouseDown="Window_MouseDown" AllowsTransparency="True">
    <Border x:Name="BorderWindow" Padding="5" BorderThickness="3,3,3,3" CornerRadius="30" BorderBrush="{DynamicResource WindowBorder}" >
        <Border.Background>
            <ImageBrush Stretch="UniformToFill" ImageSource="/Images/BackgroundClouds.jpg"/>
        </Border.Background>
        <Canvas>
            <Border BorderThickness="1" Height="86" Width="884" CornerRadius="30,30,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource TitleBackground}"/>
            <Border x:Name="BorderDescriptionBase" BorderThickness="1" Height="284" Width="862" Canvas.Left="12" Canvas.Top="89" CornerRadius="10,10,10,10" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Border.Background>
                    <ImageBrush Stretch="UniformToFill" ImageSource="/Images/BackgroundSteps.jpg"/>
                </Border.Background>
            </Border>
            <Border x:Name="BorderToAlignVerticallyEditorTitle" BorderThickness="1" Height="69" Width="415" HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Top="10" Canvas.Left="20">
                <TextBlock x:Name="LabelTitle" TextWrapping="Wrap" FontFamily="{DynamicResource WindowTitleFont}" FontSize="{DynamicResource WindowTitleSize}" FontWeight="Bold" LineStackingStrategy="BlockLineHeight" LineHeight="24" Width="414" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Consola de depuración">
                    <TextBlock.Foreground>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="White"/>
                            <GradientStop Color="White" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground></TextBlock>
            </Border>
            <TextBox x:Name="TextContent" Canvas.Left="41" Canvas.Top="120" Width="798" Height="222" AcceptsReturn="True" Effect="{DynamicResource EffectDropShadow}" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="{DynamicResource NormalTextSize}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource MonospaceFont}"/>
            <Button Effect="{DynamicResource EffectDropShadow}" x:Name="ButtonClose" Content="" Height="40" Width="40" Click="ButtonClose_Click" Canvas.Left="834" BorderBrush="{x:Null}" Canvas.Top="10" Style="{DynamicResource PushableButton}" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button.Background>
                    <ImageBrush ImageSource="/Images/ButtonClose.png"/>
                </Button.Background>
            </Button>

        </Canvas>
    </Border>
</Window>
